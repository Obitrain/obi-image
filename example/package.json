{
  "name": "@obitrain/react-native-image-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "expo run:android --port 8083",
    "ios": "expo run:ios --port 8083",
    "start": "expo start --dev-client --port 8083",
    "build:android": "cd android && ./gradlew assembleDebug --no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a",
    "build:ios": "xcodebuild -workspace ios/ReactNativeImageExample.xcworkspace -scheme ReactNativeImageExample -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO build",
    "prebuild": "expo prebuild",
    "export": "expo export --platform ios --platform android",
    "test:plugins": "node --test plugins/__tests__/*.test.mjs",
    "e2e:build:ios": "detox build -c ios.sim.release",
    "e2e:ios": "detox test -c ios.sim.release",
    "e2e:build:android": "detox build -c android.emu.release",
    "e2e:android": "detox test -c android.emu.release"
  },
  "dependencies": {
    "@d11/react-native-fast-image": "8.13.0",
    "@react-native-camera-roll/camera-roll": "7.10.2",
    "expo": "~58.0.19",
    "expo-build-properties": "~58.0.11",
    "expo-dev-client": "~58.0.15",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/runtime": "^7.29.10",
    "@jest/globals": "^30.5.2",
    "@types/react": "^19.3.0",
    "@types/react-refresh": "^0",
    "babel-preset-expo": "~58.0.20",
    "detox": "20.51.4",
    "jest": "^30.5.2",
    "react-native-builder-bob": "^0.44.1",
    "react-native-monorepo-config": "^0.4.0",
    "react-refresh": "^0.14.2"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "main": "index.js"
}
