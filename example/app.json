{
  "expo": {
    "name": "ReactNativeImageExample",
    "slug": "obi-image-example",
    "version": "1.0.0",
    "scheme": "obi-image-example",
    "ios": {
      "bundleIdentifier": "obitrain.reactnativeimage.example",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Transcode a photo from your library"
      }
    },
    "android": {
      "package": "obitrain.reactnativeimage.example",
      "allowBackup": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "./plugins/with-image-cache",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.2.0"
          }
        }
      ]
    ]
  }
}
